create or replace transient table ANOMALY_DETECTION_SYSTEM.SC1.fct_cell_performance
         as
        (

with base as (
    select *
    from ANOMALY_DETECTION_SYSTEM.SC1.stg_full_telecom
    
),

prep as (
    select
        b.id as original_id,
        t.tower_id,
        n.network_id,
        to_number(to_varchar(date_trunc('day', b.created_dt),'YYYYMMDD'))::int as date_id,
        m.maintenance_id,
        b.created_dt as created_ts,
        concat(b.id,'_',to_number(to_varchar(date_trunc('day', b.created_dt),'YYYYMMDD'))::int) as unique_row
    from base b
    left join ANOMALY_DETECTION_SYSTEM.SC1.dim_tower t
        on t.cid = b.cid and t.tac = b.tac
    left join ANOMALY_DETECTION_SYSTEM.SC1.dim_network n
        on n.mcc = b.mcc and n.mnc = b.mnc and n.radio = b.radio
    left join ANOMALY_DETECTION_SYSTEM.SC1.dim_maintenance m
        on m.maintenance_type = b.maintenance_type and m.priority = b.priority
)

select * from prep;

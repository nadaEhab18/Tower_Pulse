    to_timestamp(b.created_dt) as created_ts,
    to_number(to_varchar(date_trunc('day', to_timestamp(b.created_dt)), 'YYYYMMDD'))::int as date_id,
    d_t.tower_id,
    d_n.network_id,
    d_m.maintenance_id,
    concat(b.original_id, '_', to_number(to_varchar(date_trunc('day', to_timestamp(b.created_dt)), 'YYYYMMDD'))::int) as unique_row
  from base b
  left join ANOMALY_DETECTION_SYSTEM.SC1.dim_tower d_t
    on d_t.cid = b.cid and d_t.tac = b.tac
  left join ANOMALY_DETECTION_SYSTEM.SC1.dim_network d_n
    on d_n.mcc = b.mcc and d_n.mnc = b.mnc and d_n.radio = b.radio
  left join ANOMALY_DETECTION_SYSTEM.SC1.dim_maintenance d_m
    on d_m.maintenance_type = b.maintenance_type and d_m.priority = b.priority
)



select
  row_number() over (order by p.created_ts, p.original_id) as fact_id,
  p.original_id,
  p.tower_id,
  p.network_id,
  p.date_id,
  p.maintenance_id,
  p.created_ts,
  p.unique_row
from prep p


        );

    left join ANOMALY_DETECTION_SYSTEM.SC1.dim_maintenance m
        on m.maintenance_type = s.maintenance_type and m.priority = s.priority
)

select
    row_number() over(order by created_ts, original_id) as fact_id,
    *
from joined
        );
